# ============================================================
#  clinic-auth-service — variables de entorno
#  Copiar a .env y completar los valores
#  NUNCA commitear el .env real
# ============================================================

# ---- Servidor -----------------------------------------------
PORT=3001
NODE_ENV=development         # development | production

# ---- Base de datos PostgreSQL (propia del auth-service) -----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=auth_user
DB_PASSWORD=changeme
DB_NAME=auth_db
DB_SSL=false                 # true en producción

# ---- JWT ----------------------------------------------------
# Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=clinic-auth
JWT_AUDIENCE=clinic-web

# ---- Valkey (blocklist de tokens) ---------------------------
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_PASSWORD=changeme

# ---- Swagger (solo development) -----------------------------
SWAGGER_USER=admin
SWAGGER_PASSWORD=changeme
